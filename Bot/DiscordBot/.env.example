# ---- required -------------------------------------------------------------
# Discord bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# DeepSeek API key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=

# ---- chat channels --------------------------------------------------------
# Channels where plain messages (without a leading #) are answered.
# Comma separated list, e.g. 111111111111111111,222222222222222222
PHILIA093_CHAT_CHANNEL=

# Fallback: if the ID above is empty or points at a deleted channel, the bot
# looks for a channel with one of these names instead.
CHAT_CHANNEL_NAMES=cyrene-chat,philia093-chat,philia-chat

# Where the "Online / Offline" notices go. Defaults to the first chat channel.
ONLINE_CHANNEL_ID=

# Send "Online/Offline" notices at all? Off by default (they are noisy).
STATUS_MESSAGES=false

# ---- models ---------------------------------------------------------------
# Canonical DeepSeek model id. Aliases such as deepseek-v4-flash also work.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# ---- image generation -----------------------------------------------------
# pollinations = free, keyless, no account (default)
# aliyun       = paid Qwen-Image, used for `#imagine hq` and `#edit`
IMAGE_PROVIDER=pollinations
POLLINATIONS_MODEL=flux
IMAGE_SIZE=1024
ALIYUN_IMAGE_MODEL=qwen-image-3.0-pro
ALIYUN_IMAGE_SIZE=1328*1328
ALIYUN_EDIT_MODEL=qwen-image-2.0-pro

# ---- image recognition ----------------------------------------------------
# Any OpenAI-compatible vision endpoint. Defaults to Aliyun DashScope + Qwen3-VL.
ALIYUN_API_KEY=
# VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-plus

# ---- search ---------------------------------------------------------------
# Optional. Without it the bot falls back to keyless DuckDuckGo.
TAVILY_API_KEY=

# ---- behaviour ------------------------------------------------------------
MAX_HISTORY=30
MAX_SEARCH_RESULTS=5

# Append "🕒 21:47-13/11/2026" to every reply? Discord already shows timestamps
# and the model gets the current time in its prompt, so this is off by default.
TIMESTAMP_SUFFIX=false
TIMEZONE=Europe/Amsterdam

# ---- daily news -----------------------------------------------------------
# Once a day PhiLia searches the news, picks one story and chats about it.
NEWS_ENABLED=true
NEWS_CHANNEL_ID=
NEWS_TIME=09:30
NEWS_JITTER_MINUTES=45

# ---- minecraft (Aternos) --------------------------------------------------
# Unofficial API: needs your Aternos account. ToS forbids automation, use at
# your own risk (a dedicated account shared to the server is safer).
ATERNOS_USERNAME=
ATERNOS_PASSWORD=
# ATERNOS_SESSION=                 # alternative: paste the ATERNOS_SESSION cookie
ATERNOS_SERVER=                    # subdomain or address; empty = first server
MINECRAFT_CHANNEL_ID=
